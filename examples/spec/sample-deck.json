      "title": "East leads Q1, up 8 %",
      "categories": [
        "East",
        "South",
        "West",
        "North"
      ],
      "series": [
        {
          "name": "Growth vs Q4 (%)",
          "values": [
            8.0,
            3.0,
            0.2,
            -1.5
