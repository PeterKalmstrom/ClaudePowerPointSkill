      "notes": {
        "key_fact": "One region outperformed; the others were steady."
      }
    },
    {
      "id": "growth-hero",
      "pattern": "big_number",
      "title": "East grew faster than any region",
      "number": "+8",
      "unit": "%",
      "caption": "East revenue vs Q4. Every other region within ±3 %.",
      "notes": {
        "key_fact": "East grew 8 % quarter on quarter.",
        "facts": [
          "Constant currency",
          "One-offs excluded"
        ],
        "qa": [
          {
            "q": "Is it currency?",
            "a": "No - constant currency."
          }
        ],
        "sources": [
          "Finance dashboard, April 2026"
        ]
      }
